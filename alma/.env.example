# Copia este archivo como .env y rellena los valores.

# Clave de la API de Claude (obténla en https://platform.claude.com/).
# Si la dejas vacía, la app arranca en "modo demo" con respuestas de ejemplo.
ANTHROPIC_API_KEY=

# Modelo de Claude que responde como los personajes.
CLAUDE_MODEL=claude-opus-5-5

# Esfuerzo de razonamiento: low | medium | high | xhigh | max.
# "low" es rápido y económico, ideal para conversación.
CLAUDE_EFFORT=low

# Puerto del servidor web.
PORT=3000

# Ruta del archivo de base de datos SQLite.
DATABASE_PATH=./data/alma.db

# Pon "true" cuando la app se sirva por HTTPS (en producción) para usar cookies seguras.
COOKIE_SECURE=false

# Mensajes por minuto que puede enviar cada usuario (protege tu gasto en la API).
MESSAGES_PER_MINUTE=20

# Pon "true" si el servidor está detrás de un proxy (Render, Railway, Nginx…).
TRUST_PROXY=false
