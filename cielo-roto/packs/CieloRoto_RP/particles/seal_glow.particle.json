          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.85,
          0.96,
          1.0,
          "0.9 * math.clamp(v.particle_age * 4.0, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) / (v.particle_lifetime * 0.4), 0, 1)"
