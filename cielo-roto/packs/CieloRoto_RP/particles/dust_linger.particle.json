{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sky:dust_linger",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sky_dust"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 1.5,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.2, 0.6)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-15, 15)"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(4, 7)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.25,
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "2.0 + v.particle_age * 0.5",
          "2.0 + v.particle_age * 0.5"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 512,
          "texture_height": 128,
          "uv": [
            "math.floor(v.particle_random_1 * 3.99) * 128",
            0
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.72,
          0.66,
          0.57,
          "0.35 * math.clamp(v.particle_age * 4.0, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) / (v.particle_lifetime * 0.4), 0, 1)"
        ]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
