{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sky:void_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sky_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 6,
        "direction": "inwards"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 1.0)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(3, 5)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -1.2,
          0
        ],
        "linear_drag_coefficient": 0.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.2,
          0.2
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.55,
          0.3,
          0.8,
          "0.8 * math.clamp(v.particle_age * 4.0, 0, 1) * math.clamp((v.particle_lifetime - v.particle_age) / (v.particle_lifetime * 0.4), 0, 1)"
        ]
      }
    }
  }
}
